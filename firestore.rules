rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile access: public read for avatar/name, write by owner
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Group access: members only
    match /groups/{groupId} {
      allow read, write: if true; // In demo/public groups, allow access; or: if request.auth != null && request.auth.uid in resource.data.members;
    }
    
    // Expenses: members of the group can read and create
    match /expenses/{expenseId} {
      allow read, write: if true;
    }
  }
}
